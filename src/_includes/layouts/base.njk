<!doctype html>
<html lang="{{ site.language }}"{% if site.showPlaceholders %} class="show-ph"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url != "/" %}{{ title }} &ndash; {{ site.name }}{% else %}{{ site.name }} &ndash; {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {#- How the page looks when its link is shared (messages, social media):
      its title, description and a picture (shareImage, worked out in
      src/_data/eleventyComputed.js). The addresses have to be complete, so
      they start with site.origin. #}
  {%- set pageTitle %}{% if page.url != "/" %}{{ title }} – {{ site.name }}{% else %}{{ site.name }} – {{ site.tagline }}{% endif %}{% endset %}
  {%- if page.url != "/404.html" %}
  <link rel="canonical" href="{{ site.origin }}{{ page.url | url }}">
  <meta property="og:url" content="{{ site.origin }}{{ page.url | url }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or site.description }}">
  {%- set share = shareImage or { url: "/assets/img/share.png", width: 1200, height: 630, alt: "Callum Tham, handwritten: video creator, sound designer and producer, Melbourne, Australia" } %}
  <meta property="og:image" content="{{ site.origin }}{{ share.url | url }}">
  <meta property="og:image:width" content="{{ share.width }}">
  <meta property="og:image:height" content="{{ share.height }}">
  <meta property="og:image:alt" content="{{ share.alt }}">
  <meta property="og:locale" content="en_AU">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/reenie-beanie-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  <script>
    document.documentElement.classList.add("js");
    /* Placeholders (things still to fill in) are hidden from visitors. Add
       ?placeholders to any address to see them, with their notes, until
       ?placeholders=off (the browser remembers). See the README. */
    try {
      var ph = location.search.match(/[?&]placeholders(?:=([^&]*))?/);
      if (ph) localStorage.setItem("placeholders", ph[1] === "off" ? "off" : "on");
      if (localStorage.getItem("placeholders") === "on") document.documentElement.classList.add("show-ph");
    } catch (e) { /* no storage: placeholders stay hidden */ }
  </script>
  <script src="/assets/js/site.js?v={{ build.version }}" defer></script>
  {%- for src in scripts %}
  <script src="{{ src }}?v={{ build.version }}" defer></script>
  {%- endfor %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="page{% if wide %} page--wide{% endif %}">
    {% include "partials/header.njk" %}

    {% include "partials/nav.njk" %}

    <main id="main" class="main{% if signoff %} main--signoff{% endif %}" tabindex="-1">
      <div class="content">
{{ content | safe }}
      </div>
      {%- if figures and figures.length %}

      <div class="figures">
        {#- asyncEach, not for: {% image %} resizes pictures as it goes #}
        {%- asyncEach figure in figures %}
        {% image figure %}
        {%- endeach %}
      </div>
      {%- if not figuresLast %}
      <script>
        /* On phones the pictures move up under the page's opening line, as a
           strip to swipe through, instead of waiting below the text (unless
           the page says `figuresLast: true`, like Contact, where what you
           read matters more). Runs here, as the page is drawn, so nothing
           jumps. */
        (function () {
          var figures = document.currentScript.previousElementSibling;
          var content = figures.parentNode.querySelector(".content");
          var after = content.querySelector(":scope > .standfirst") || content.querySelector(":scope > h1");
          var phone = window.matchMedia("(max-width: 759.98px)");
          function place() {
            if (phone.matches && after) after.after(figures);
            else content.after(figures);
          }
          place();
          phone.addEventListener("change", place);
        })();
      </script>
      {%- endif %}
      {%- endif %}
      {%- if signoff %}

      {#- A quote that signs the page off, at the very bottom (About Me) #}
      <blockquote class="quote quote--hand signoff">
        <p>&ldquo;{{ signoff.quote }}&rdquo;</p>
        <p class="quote__by">&ndash; {{ signoff.by }}</p>
      </blockquote>
      {%- endif %}
    </main>

    {% include "partials/footer.njk" %}
  </div>
</body>
</html>

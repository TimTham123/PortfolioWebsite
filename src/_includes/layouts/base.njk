<!doctype html>
<html lang="{{ site.language }}"{% if site.showPlaceholders %} class="show-ph"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url != "/" %}{{ title }} &ndash; {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/reenie-beanie-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  <script>
    document.documentElement.classList.add("js");
    /* Placeholders (things still to fill in) are hidden from visitors. Add
       ?placeholders to any address to see them, with their notes, until
       ?placeholders=off (the browser remembers). See the README. */
    try {
      var ph = location.search.match(/[?&]placeholders(?:=([^&]*))?/);
      if (ph) localStorage.setItem("placeholders", ph[1] === "off" ? "off" : "on");
      if (localStorage.getItem("placeholders") === "on") document.documentElement.classList.add("show-ph");
    } catch (e) { /* no storage: placeholders stay hidden */ }
  </script>
  <script src="/assets/js/site.js?v={{ build.version }}" defer></script>
  {%- for src in scripts %}
  <script src="{{ src }}?v={{ build.version }}" defer></script>
  {%- endfor %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="page{% if wide %} page--wide{% endif %}">
    {% include "partials/header.njk" %}

    {% include "partials/nav.njk" %}

    <main id="main" class="main{% if signoff %} main--signoff{% endif %}" tabindex="-1">
      <div class="content">
{{ content | safe }}
      </div>
      {%- if figures and figures.length %}

      <div class="figures">
        {#- asyncEach, not for: {% image %} resizes pictures as it goes #}
        {%- asyncEach figure in figures %}
        {% image figure %}
        {%- endeach %}
      </div>
      <script>
        /* On phones the pictures move up under the page's opening line, as a
           strip to swipe through, instead of waiting below the text. Runs
           here, as the page is drawn, so nothing jumps. */
        (function () {
          var figures = document.currentScript.previousElementSibling;
          var content = figures.parentNode.querySelector(".content");
          var after = content.querySelector(":scope > .standfirst") || content.querySelector(":scope > h1");
          var phone = window.matchMedia("(max-width: 759.98px)");
          function place() {
            if (phone.matches && after) after.after(figures);
            else content.after(figures);
          }
          place();
          phone.addEventListener("change", place);
        })();
      </script>
      {%- endif %}
      {%- if signoff %}

      {#- A quote that signs the page off, at the very bottom (About Me) #}
      <blockquote class="quote quote--hand signoff">
        <p>&ldquo;{{ signoff.quote }}&rdquo;</p>
        <p class="quote__by">&ndash; {{ signoff.by }}</p>
      </blockquote>
      {%- endif %}
    </main>

    {% include "partials/footer.njk" %}
  </div>
</body>
</html>

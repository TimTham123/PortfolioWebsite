<!doctype html>
<html lang="{{ site.language }}"{% if site.showPlaceholders %} class="show-ph"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url != "/" %}{{ seoTitle or title }} &ndash; {{ site.name }}{% else %}{{ site.name }} &ndash; {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.name }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {#- How the page looks when its link is shared (messages, social media):
      its title, description and a picture (shareImage, worked out in
      src/_data/eleventyComputed.js). The addresses have to be complete, so
      they start with the site's address (build.origin, from the deploy, or
      site.origin). #}
  {%- set origin = build.origin or site.origin %}
  {%- set pageTitle %}{% if page.url != "/" %}{{ seoTitle or title }} – {{ site.name }}{% else %}{{ site.name }} – {{ site.tagline }}{% endif %}{% endset %}
  {%- if page.url != "/404.html" %}
  <link rel="canonical" href="{{ origin }}{{ page.url | url }}">
  <meta property="og:url" content="{{ origin }}{{ page.url | url }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or site.description }}">
  {%- set share = shareImage or { url: "/assets/img/share.png", width: 1200, height: 630, alt: "Callum Tham, handwritten: video creator, sound designer and social media producer, Melbourne, Australia" } %}
  <meta property="og:image" content="{{ origin }}{{ share.url | url }}">
  <meta property="og:image:width" content="{{ share.width }}">
  <meta property="og:image:height" content="{{ share.height }}">
  <meta property="og:image:alt" content="{{ share.alt }}">
  <meta property="og:locale" content="en_AU">
  <meta name="twitter:card" content="summary_large_image">
  {%- if page.url == "/" %}
  {% include "partials/structured-data.njk" %}
  {%- endif %}
  <meta name="theme-color" content="#fafafa">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/figtree-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/nunito-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/reenie-beanie-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  {%- if signoff %}
  <link rel="preload" href="/assets/fonts/waiting-for-the-sunrise-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  {%- endif %}
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  <script>
    document.documentElement.classList.add("js");
    /* Placeholders (things still to fill in) are hidden from visitors. Add
       ?placeholders to any address to see them, with their notes, until
       ?placeholders=off (the browser remembers). See the README. */
    try {
      var ph = location.search.match(/[?&]placeholders(?:=([^&]*))?/);
      if (ph) localStorage.setItem("placeholders", ph[1] === "off" ? "off" : "on");
      if (localStorage.getItem("placeholders") === "on") document.documentElement.classList.add("show-ph");
    } catch (e) { /* no storage: placeholders stay hidden */ }
  </script>
  {%- if signoff %}
  <script>
    /* About Me on a phone, the first time: the quote is written out by hand
       before the page appears (see "The intro" in style.css). Decided here,
       before anything is drawn, so the page doesn't flash up first. Not on
       bigger screens, not for search engines' robots, and only once (the
       browser remembers; without storage it doesn't play at all). */
    try {
      if (window.matchMedia("(max-width: 759.98px)").matches &&
          !/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent) &&
          !localStorage.getItem("intro-seen")) {
        localStorage.setItem("intro-seen", "1");
        document.documentElement.classList.add("show-intro");
      }
    } catch (e) { /* no storage: no intro */ }
  </script>
  {%- endif %}
  <script src="/assets/js/site.js?v={{ build.version }}" defer></script>
  {%- for src in scripts %}
  <script src="{{ src }}?v={{ build.version }}" defer></script>
  {%- endfor %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {%- if signoff %}

  {#- The intro (phones, first visit): the quote, word by word, as if being
      written, then it fades away and leaves the page. Tap to skip. Hidden
      from screen readers: the page's own text is there underneath. #}
  <div class="intro" aria-hidden="true">
    <div class="intro__quote">
      {%- set words = signoff.quote.split(" ") %}
      <p>{% for w in words %}<span class="intro__w" style="--i: {{ loop.index0 }}">{% if loop.first %}&ldquo;{% endif %}{{ w }}{% if loop.last %}&rdquo;{% endif %}</span>{% if not loop.last %} {% endif %}{% endfor %}</p>
      <p class="intro__by" style="--i: {{ words.length + 2 }}">&ndash; {{ signoff.by }}</p>
    </div>
    <p class="intro__tap">Tap to continue</p>
  </div>
  <script>
    (function () {
      var root = document.documentElement;
      var intro = document.currentScript.previousElementSibling;
      if (!root.classList.contains("show-intro")) { intro.remove(); return; }
      var gone = false;
      function leave() {
        if (gone) return;
        gone = true;
        intro.classList.add("is-leaving");
        setTimeout(function () { root.classList.remove("show-intro"); intro.remove(); }, 700);
      }
      /* Start writing once the handwriting has loaded (or after a second,
         whichever comes first). The writing takes 2.8 seconds (the last
         word, then the name: 51 x 50ms + 0.26s in style.css); the quote then
         holds for 15 seconds and leaves, 17.8 seconds after it began. Five
         seconds into the hold, "Tap to continue" fades in underneath */
      var WRITE = 2800;
      var HOLD = 15000;
      var TAP_AFTER = 5000; // into the hold
      var started = false;
      function write() {
        if (started) return;
        started = true;
        intro.classList.add("is-writing");
        setTimeout(function () { intro.classList.add("is-waiting"); }, WRITE + TAP_AFTER);
        setTimeout(leave, WRITE + HOLD);
      }
      if (document.fonts && document.fonts.load) {
        document.fonts.load('1em "Waiting for the Sunrise"').then(write, write);
      }
      setTimeout(write, 1000);
      intro.addEventListener("click", leave);
    })();
  </script>
  {%- endif %}

  <div class="page{% if wide %} page--wide{% endif %}{% if signoff %} page--signoff{% endif %}">
    {% include "partials/header.njk" %}

    {% include "partials/nav.njk" %}

    <main id="main" class="main{% if signoff %} main--signoff{% endif %}" tabindex="-1">
      <div class="content">
{{ content | safe }}
      </div>
      {%- if figures and figures.length %}

      <div class="figures">
        {#- asyncEach, not for: {% image %} resizes pictures as it goes #}
        {%- asyncEach figure in figures %}
        {%- if figure.embed %}
        {% embed figure.embed %}
        {%- elif figure.video %}
        {% video figure.video %}
        {%- else %}
        {% image figure %}
        {%- endif %}
        {%- endeach %}
      </div>
      {%- if not figuresLast %}
      <script>
        /* On phones the pictures move up under the page's opening line, as a
           strip to swipe through, instead of waiting below the text (unless
           the page says `figuresLast: true`, like Contact, where what you
           read matters more). Runs here, as the page is drawn, so nothing
           jumps. */
        (function () {
          var figures = document.currentScript.previousElementSibling;
          var content = figures.parentNode.querySelector(".content");
          var after = content.querySelector(":scope > .standfirst") || content.querySelector(":scope > h1");
          var phone = window.matchMedia("(max-width: 759.98px)");
          function place() {
            if (phone.matches && after) after.after(figures);
            else content.after(figures);
          }
          place();
          phone.addEventListener("change", place);
        })();
      </script>
      {%- endif %}
      {%- endif %}
      {%- if signoff %}

      {#- A quote that signs the page off, at the very bottom (About Me) #}
      <blockquote class="quote quote--hand signoff">
        <p>&ldquo;{{ signoff.quote }}&rdquo;</p>
        <p class="quote__by">&ndash; {{ signoff.by }}</p>
      </blockquote>
      {%- endif %}
    </main>
  </div>
</body>
</html>

---
layout: layouts/base.njk
---
{#- Layout for sub-pages (the Sound Design projects, the Interests): the page itself,
    then links to the previous / next project (it wraps round at the ends). #}
{{ content | safe }}
{%- set pages = navigation | pager(page.url) %}
{%- if pages %}

<nav class="pager" aria-label="{{ pages.parent.title }} pages">
  <a href="{{ pages.prev.url }}" rel="prev">&larr; {{ pages.prev.title }}</a>
  <a href="{{ pages.next.url }}" rel="next">{{ pages.next.title }} &rarr;</a>
</nav>
{%- endif %}

{#-
  Main navigation (the index). The items come from src/_data/navigation.json;
  edit that file (not this one) to rename, reorder or add pages.

  Three levels:
    a section label with no page (Me, Work)
      → pages (About Me, Sounds Of…), some with sub-pages behind a "+"
        → sub-pages (Music, Cyberpedia…)
  A top-level item with a url (Qualifications…, Contact) is a plain link.
  An item with "link": false (Interests) isn't a link: clicking its name
  opens and closes its sub-pages.
-#}
{%- macro navItem(item, id, currentUrl) %}
  {%- if item.children %}
    {%- set open = currentUrl | inSection(item.url) %}
    <li class="nav-group" data-open="{{ 'true' if open else 'false' }}" data-key="{{ item.url }}">
      <div class="nav-group__head">
        {%- if item.link === false %}
        <button class="nav-toggle nav-toggle--label{% if open %} is-section{% endif %}" type="button" aria-expanded="{{ 'true' if open else 'false' }}" aria-controls="{{ id }}">{{ item.title }}<span class="nav-toggle__icon" aria-hidden="true"></span></button>
        {%- else %}
        <a href="{{ item.url }}"{% if currentUrl == item.url %} aria-current="page"{% elif open %} class="is-section"{% endif %}>{{ item.title }}</a>
        <button class="nav-toggle" type="button" aria-expanded="{{ 'true' if open else 'false' }}" aria-controls="{{ id }}">
          <span class="visually-hidden">{{ item.title }} pages</span>
          <span class="nav-toggle__icon" aria-hidden="true"></span>
        </button>
        {%- endif %}
      </div>
      <ul class="nav-sub" id="{{ id }}">
        {%- for child in item.children %}
        <li><a href="{{ child.url }}"{% if currentUrl == child.url %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
        {%- endfor %}
      </ul>
    </li>
  {%- else %}
    <li><a href="{{ item.url }}"{% if currentUrl == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
  {%- endif %}
{%- endmacro %}

<nav class="site-nav" id="site-nav" aria-label="Main">
  <ul class="nav-list">
    {%- for section in navigation %}
    {%- set sectionIndex = loop.index %}
    {%- if section.url %}
    {{ navItem(section, "nav-sub-" + sectionIndex, page.url) }}
    {%- else %}
    <li class="nav-section">
      <span class="nav-label" id="nav-label-{{ sectionIndex }}">{{ section.title }}</span>
      <ul aria-labelledby="nav-label-{{ sectionIndex }}">
        {%- for item in section.children %}
        {{ navItem(item, "nav-sub-" + sectionIndex + "-" + loop.index, page.url) }}
        {%- endfor %}
      </ul>
    </li>
    {%- endif %}
    {%- endfor %}
  </ul>
</nav>
<script>
  /* Which dropdowns (Interests, Sound Design) start open. The one for the
     section you're in is open. On wider screens, once one has been open it
     stays open from page to page until it's closed with its button
     (remembered for the visit, in the browser's session storage; see also
     site.js). On phones, where the index opens over the page from the Menu
     button, only the section you're in starts open, so the whole list fits
     on the screen. Runs here, before the rest of the page is drawn, so
     nothing jumps. */
  (function () {
    var open = [];
    try { open = JSON.parse(sessionStorage.getItem("nav-open")) || []; } catch (e) {}
    var phone = window.matchMedia("(max-width: 759.98px)").matches;
    document.querySelectorAll(".nav-group").forEach(function (group) {
      var key = group.getAttribute("data-key");
      var isOpen = group.getAttribute("data-open") === "true" || (!phone && open.indexOf(key) !== -1);
      group.setAttribute("data-open", isOpen ? "true" : "false");
      group.querySelector(".nav-toggle").setAttribute("aria-expanded", isOpen ? "true" : "false");
      if (isOpen && !phone && open.indexOf(key) === -1) open.push(key);
    });
    try { sessionStorage.setItem("nav-open", JSON.stringify(open)); } catch (e) {}
  })();
</script>

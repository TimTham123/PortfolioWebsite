{#-
  Main navigation (the index). The items come from src/_data/navigation.json;
  edit that file (not this one) to rename, reorder or add pages.
  "groupStart" there leaves a blank line before an item.
-#}
<nav class="site-nav" aria-label="Main">
  <ul class="nav-list">
    {%- for item in navigation %}
    {%- set groupClass = " nav-group-start" if item.groupStart else "" %}
    {%- if item.children %}
    {%- set open = page.url | inSection(item.url) %}
    <li class="nav-group{{ groupClass }}" data-open="{{ 'true' if open else 'false' }}">
      <div class="nav-group__head">
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif open %} class="is-section"{% endif %}>{{ item.title }}</a>
        <button class="nav-toggle" type="button" aria-expanded="{{ 'true' if open else 'false' }}" aria-controls="nav-sub-{{ loop.index }}">
          <span class="visually-hidden">{{ item.title }} pages</span>
          <span class="nav-toggle__icon" aria-hidden="true"></span>
        </button>
      </div>
      <ul class="nav-sub" id="nav-sub-{{ loop.index }}">
        {%- for child in item.children %}
        <li><a href="{{ child.url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
        {%- endfor %}
      </ul>
    </li>
    {%- else %}
    <li{% if item.groupStart %} class="nav-group-start"{% endif %}><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
    {%- endif %}
    {%- endfor %}
  </ul>
</nav>
<script>
  /* Small screens start with the dropdown closed so the page itself stays near the top.
     Runs here, before the rest of the page is drawn, so nothing jumps. */
  if (window.matchMedia("(max-width: 759.98px)").matches) {
    document.querySelectorAll(".nav-group[data-open='true']").forEach(function (group) {
      group.setAttribute("data-open", "false");
      group.querySelector(".nav-toggle").setAttribute("aria-expanded", "false");
    });
  }
</script>
